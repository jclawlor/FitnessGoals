package dev.jclawlor.FitnessGoals.entity;

import jakarta.persistence.*;
import lombok.Data;

@Entity
@Table(name = "hydration")
@Data
public class Hydration {
	
	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	private Long id;
	
	private double waterIntakeOunces;
	
	
	public Hydration() {
		// default constructor
	}
	
	public Long getId() {
		return id;
	}
	
	public void setId(Long id) {
		this.id = id;
	}
	
	public double getWaterIntakeOunces() {
		return waterIntakeOunces;
	}
	
	public void setWaterIntakeOunces(double waterIntakeOunces) {
		this.waterIntakeOunces = waterIntakeOunces;
	}
}
