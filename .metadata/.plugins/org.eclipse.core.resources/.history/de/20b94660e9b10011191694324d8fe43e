	@Test
	@Transactional
	public void testGetAllLogs() throws Exception {
		RegisterRequestDto registerRequest = new RegisterRequestDto("testuser", "testuser@gmail.com", "password");
		authService.register(registerRequest);
		
		final String logs = mvc.perform( get( "/api/logs" ) ).andDo( print() ).andExpect( status().isOk() )
                .andReturn().getResponse().getContentAsString();
		
		
		assertTrue(logs.contains("[]"));
		
		dailyLogService.createLog("testuser", java.time.LocalDate.of(2024, 6, 1));
		mvc.perform(get("/api/logs"))
			.andDo(print())
			.andExpect(status().isOk());
		
		DailyLogDto createdLog = dailyLogService.getLogByDate("testuser", java.time.LocalDate.of(2024, 6, 1));
		assertEquals(java.time.LocalDate.of(2024, 6, 1), createdLog.getDate());
	}
	
	@Test
	@Transactional
	public void testGetLogByDate() throws Exception {
		RegisterRequestDto registerRequest = new RegisterRequestDto("testuser", "testuser@gmail.com", "password");
		authService.register(registerRequest);
		
		
		dailyLogService.createLog("testuser", java.time.LocalDate.of(2024, 6, 1));
		dailyLogService.createLog("testuser", java.time.LocalDate.of(2024, 6, 2));
		mvc.perform( get( "/api/logs/2024-06-01" ) ).andDo( print() ).andExpect( status().isOk() );
		
		mvc.perform( get( "/api/logs/2024-06-02" ) ).andDo( print() ).andExpect( status().isOk() );
		
		DailyLogDto log1 = dailyLogService.getLogByDate("testuser", java.time.LocalDate.of(2024, 6, 1));
		DailyLogDto log2 = dailyLogService.getLogByDate("testuser", java.time.LocalDate.of(2024, 6, 2));
		
		assertAll(
			() -> assertEquals(java.time.LocalDate.of(2024, 6, 1), log1.getDate()),
			() -> assertEquals(java.time.LocalDate.of(2024, 6, 2), log2.getDate())
		);
		
	}
	
	
