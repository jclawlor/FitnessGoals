	@Test
	@Transactional
	public void testAddMealById() throws Exception {
		RegisterRequestDto registerRequest = new RegisterRequestDto("testuser", "testuser@gmail.com", "password");
		authService.register(registerRequest);
		dailyLogService.createLog("testuser", java.time.LocalDate.of(2024, 6, 1));
		
		MealDto mealDto = new MealDto("Chicken Salad", 400, 20, 30, 10, TimeOfDay.LUNCH);
		MealDto savedMealDto = mealService.addMeal(mealDto);
		mvc.perform(post("/api/logs/2024-06-01/meals/" + savedMealDto.getId())
				.accept(MediaType.APPLICATION_JSON))
				.andDo(print())
			.andExpect(status().isOk())
			.andExpect(jsonPath("$.meals[0].name").value("Chicken Salad"))
			.andExpect(jsonPath("$.meals[0].calories").value(400))
			.andExpect(jsonPath("$.meals[0].carbohydrates").value(20))
			.andExpect(jsonPath("$.meals[0].protein").value(30))
			.andExpect(jsonPath("$.meals[0].fat").value(10))
			.andExpect(jsonPath("$.meals[0].timeOfDay").value(TimeOfDay.LUNCH.toString()));
	}
	
