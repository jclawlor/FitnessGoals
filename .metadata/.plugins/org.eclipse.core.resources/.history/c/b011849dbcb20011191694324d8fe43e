	@Test
	@Transactional
	public void testAddWater() {
		final RegisterRequestDto registerDto = new RegisterRequestDto("testuser1", "testemail1", "testpassword1");
		authService.register(registerDto);
		LocalDate date1 = LocalDate.of(2024, 6, 1);
		
		dailyLogService.createLog("testuser1", date1);
		
		assertEquals(0.0, dailyLogService.getLogByDate("testuser1", date1).getWaterOunces());
		
		DailyLogDto dailyLogDto = dailyLogService.addWater("testuser1", date1);
		assertAll("DailyLogDto contents",
				() -> assertEquals("testuser1", dailyLogDto.getUsername()),
				() -> assertEquals(date1, dailyLogDto.getDate()),
				() -> assertEquals(16.0, dailyLogDto.getWaterOunces()));
		
		DailyLogDto dailyLogDto2 = dailyLogService.addWater("testuser1", date1);
		assertAll("DailyLogDto contents",
				() -> assertEquals("testuser1", dailyLogDto2.getUsername()),
				() -> assertEquals(date1, dailyLogDto2.getDate()),
				() -> assertEquals(32.0, dailyLogDto2.getWaterOunces()));
		
	}
	
	
