	@Test
	@Transactional
	public void testGetAllLogsForUser() {
		final RegisterRequestDto registerDto = new RegisterRequestDto("testuser1", "testemail1", "testpassword1");
		authService.register(registerDto);
		LocalDate date1 = LocalDate.of(2024, 6, 1);
		LocalDate date2 = LocalDate.of(2024, 6, 2);
		LocalDate date3 = LocalDate.of(2024, 6, 3);
		
		dailyLogService.createLog("testuser1", date1);
		dailyLogService.createLog("testuser1", date2);
		dailyLogService.createLog("testuser1", date3);
		List<DailyLogDto> dailyLogList = dailyLogService.getAllLogsForUser("testuser1");
		assertAll("DailyLogDto contents",
				() -> assertEquals(3, dailyLogList.size()),
				() -> assertEquals(date1, dailyLogList.get(0).getDate()),
				() -> assertEquals(date2, dailyLogList.get(1).getDate()),
				() -> assertEquals(date3, dailyLogList.get(2).getDate()));
		
		
		
		
	}
	
	@Test
	@Transactional
	public void testGetLogByDate() {
		final RegisterRequestDto registerDto = new RegisterRequestDto("testuser1", "testemail1", "testpassword1");
		authService.register(registerDto);
		LocalDate date1 = LocalDate.of(2024, 6, 1);
		LocalDate date2 = LocalDate.of(2024, 6, 2);
		
		
		
		dailyLogService.createLog("testuser1", date1);
		DailyLogDto dailyLogDto = dailyLogService.getLogByDate("testuser1", date1);
		assertAll("DailyLogDto contents",
				() -> assertEquals("testuser1", dailyLogDto.getUsername()),
				() -> assertEquals(date1, dailyLogDto.getDate()),
				() -> assertNotEquals(date2, dailyLogDto.getDate()));
		
	}
	
	@Transactional
	@Test
	public void testCreateLog() {
		final RegisterRequestDto registerDto = new RegisterRequestDto("testuser1", "testemail1", "testpassword1");
		authService.register(registerDto);
		LocalDate date1 = LocalDate.of(2024, 6, 1);
		
		DailyLogDto dailyLogDto = dailyLogService.createLog("testuser1", date1);
		assertAll("DailyLogDto contents",
				() -> assertEquals("testuser1", dailyLogDto.getUsername()),
				() -> assertEquals(date1, dailyLogDto.getDate()),
				() -> assertEquals(0, dailyLogDto.getMeals().size()),
				() -> assertEquals(0, dailyLogDto.getLiftingExercises().size()),
				() -> assertEquals(0, dailyLogDto.getCardioExercises().size()),
				() -> assertEquals(0, dailyLogDto.getWaterOunces()));
		
		LocalDate date2 = LocalDate.of(2024, 6, 2);
		DailyLogDto dailyLogDto2 = dailyLogService.createLog("testuser1", date2);
		assertAll("DailyLogDto contents",
				() -> assertEquals("testuser1", dailyLogDto2.getUsername()),
				() -> assertEquals(date2, dailyLogDto2.getDate()));
	}
	
	
