	@Test
	@Transactional
	public void testAddMealToLog() {
		final RegisterRequestDto registerDto = new RegisterRequestDto("testuser1", "testemail1", "testpassword1");
		authService.register(registerDto);
		LocalDate date1 = LocalDate.of(2024, 6, 1);
		
		dailyLogService.createLog("testuser1", date1);
		MealDto mealDto = new MealDto("Eggs", 500, 20, 30, 10, TimeOfDay.BREAKFAST);
		MealDto createdMealDto = mealService.addMeal(mealDto);
		Long mealId = createdMealDto.getId();
		
		DailyLogDto dailyLogDto = dailyLogService.addMealToLog("testuser1", date1, mealId);
		assertAll("DailyLogDto contents",
				() -> assertEquals("testuser1", dailyLogDto.getUsername()),
				() -> assertEquals(date1, dailyLogDto.getDate()),
				() -> assertEquals(1, dailyLogDto.getMeals().size()),
				() -> assertEquals("Eggs", dailyLogDto.getMeals().get(0).getName()),
				() -> assertEquals(TimeOfDay.BREAKFAST, dailyLogDto.getMeals().get(0).getTimeOfDay()),
				() -> assertEquals(0, dailyLogDto.getWaterOunces()));
		
		
	}
	
	
	
